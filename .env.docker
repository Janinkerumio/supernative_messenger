# Copy to a real secrets store / --env-file for `docker run`.
# docker compose reads this automatically.

APP_NAME=SuperNative
APP_ENV=production
APP_KEY=                       # REQUIRED: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.example.com
APP_ROLE=server

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (compose provides `mysql`) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=supernative
DB_USERNAME=supernative
DB_PASSWORD=change-me

# --- Cache / queue / session (compose provides `redis`) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Broadcasting (Reverb runs inside the same container on :8081) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=supernative
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret
# What PHP (and, after your reverse proxy, clients) use to reach Reverb.
# In-container the broadcaster talks to localhost; put the public host here
# once Reverb sits behind TLS at your domain (REVERB_HOST=api.example.com,
# REVERB_PORT=443, REVERB_SCHEME=https).
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

# --- Firebase Cloud Messaging (leave disabled until you drop the JSON in) ---
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS=/var/www/html/storage/app/firebase/service-account.json

# --- Mobile build points at this server; not read by the server itself ---
MESSENGER_API_URL=
